<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.lake</groupId>
  <artifactId>lake-parent</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Drishti Lake (reactor)</name>

  <modules>
    <module>lake-api</module>
    <module>lake-io</module>
    <module>lake-config</module>
    <module>lake-delta</module>
    <module>lake-iceberg</module>
    <module>lake-load</module>
    <module>lake-tck</module>
    <module>lake-guards</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Third-party versions: those of the host at the freeze commit (Drishti main 9ce7c3170), so the moved code runs on what it was
         tested with (design section 6). -->
    <delta-kernel.version>4.4.0</delta-kernel.version>
    <iceberg.version>1.10.1</iceberg.version>
    <parquet.version>1.18.0</parquet.version>
    <hadoop.version>3.4.3</hadoop.version>
    <awssdk.version>2.55.9</awssdk.version>
    <snappy-java.version>1.1.10.4</snappy-java.version>
    <lz4-java.version>1.10.2</lz4-java.version>
    <zstd-jni.version>1.5.7-6</zstd-jni.version>
    <caffeine.version>3.2.4</caffeine.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <s3mock.version>4.12.4</s3mock.version>
    <!-- SPLIT EXEMPTION (SPLIT_EXEMPTIONS.md): the versions the host's Spring Boot parent chose for Jackson, SLF4J, JUnit, AssertJ,
         Logback and the libraries' shared transitive dependencies, imported as a bill of materials (versions only: no Spring
         artifact on any class path but the S3 mock's, test scope). Leaves at L12, when lake-bom pins its own. -->
    <host-boot-bom.version>3.5.16</host-boot-bom.version>
    <kotlin.version>2.2.21</kotlin.version>
    <lake.test.forks>4</lake.test.forks>
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- the host overrode the Kotlin version its parent chose (the S3 mock runs on Kotlin) -->
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-bom</artifactId><version>${kotlin.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>${host-boot-bom.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-io</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-config</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-delta</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-iceberg</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-load</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-hadoop</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-column</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-common</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-encoding</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-format-structures</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-jackson</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-avro</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>org.apache.parquet</groupId><artifactId>parquet-variant</artifactId><version>${parquet.version}</version></dependency>
      <dependency><groupId>com.github.luben</groupId><artifactId>zstd-jni</artifactId><version>${zstd-jni.version}</version></dependency>
      <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId><version>${caffeine.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><version>${testcontainers.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
        <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${lake.test.forks}</forkCount>
          <reuseForks>true</reuseForks>
          <!-- the test JVMs' temp folder is the module's target/tmp, never the system /tmp -->
          <tempDir>tmp</tempDir>
          <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <jdk.http.auth.tunneling.disabledSchemes></jdk.http.auth.tunneling.disabledSchemes>
            <!-- the product's own roots (LakeOptions); every root is absolute (explicit paths) -->
            <lake.data.dir>${project.build.directory}/test-data</lake.data.dir>
            <lake.home>${project.basedir}</lake.home>
            <lake.repo.root>${maven.multiModuleProjectDirectory}/..</lake.repo.root>
            <lake.module.root>${project.basedir}</lake.module.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <bannedDependencies>
                  <!-- No host, and no Spring outside test scope (the S3 mock is a Spring Boot application, test scope only). -->
                  <excludes>
                    <exclude>com.ash.drishti*:*</exclude>
                    <exclude>org.springframework*:*:*:*:compile</exclude>
                    <exclude>org.springframework*:*:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
