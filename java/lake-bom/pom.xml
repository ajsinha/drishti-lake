<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- The product's bill of materials: a host imports it (scope import) and pins every Drishti Lake module and the third-party versions the
       product runs on, from one place. It is also the parent of the reactor (java/pom.xml), so the build uses exactly these versions.
       Test support's own libraries (the S3 simulator, JUnit) are pinned in the reactor, never here. -->
  <groupId>com.ash.lake</groupId>
  <artifactId>lake-bom</artifactId>
  <version>0.9.2</version>
  <packaging>pom</packaging>
  <name>Drishti Lake: bill of materials</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Third-party versions: those of the host at the freeze commit (Drishti main 9ce7c3170), so the moved code runs on what it was
         tested with (design section 6). -->
    <delta-kernel.version>4.4.0</delta-kernel.version>
    <iceberg.version>1.10.1</iceberg.version>
    <parquet.version>1.18.0</parquet.version>
    <hadoop.version>3.4.3</hadoop.version>
    <awssdk.version>2.55.9</awssdk.version>
    <snappy-java.version>1.1.10.4</snappy-java.version>
    <lz4-java.version>1.10.2</lz4-java.version>
    <zstd-jni.version>1.5.7-6</zstd-jni.version>
    <caffeine.version>3.2.4</caffeine.version>
    <!-- Drishti Tools (settings, net, concurrent, time, codec, files, testkit): one version for every module, through its tools-bom. -->
    <drishti.tools.version>1.1.0</drishti.tools.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-bom</artifactId><version>${drishti.tools.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.21</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.21.4</version></dependency>
